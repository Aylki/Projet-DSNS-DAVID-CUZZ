# Grafana configuration – géré par Ansible, ne pas modifier manuellement

#################################### Serveur ####################################
[server]
http_addr = {{ grafana_ip }}
http_port = 3000
domain = {{ grafana_domain }}
root_url = http://{{ grafana_domain }}:3000/
serve_from_sub_path = false

#################################### Base de données (SQLite) ##################
[database]
type = sqlite3
path = {{ grafana_db_path }}
# Timeout de connexion en secondes
conn_max_lifetime = 14400

#################################### Sécurité ###################################
[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
# Clé secrète pour la signature des sessions – ne pas changer après le premier démarrage
secret_key = {{ grafana_secret_key }}
disable_gravatar = true
cookie_secure = false          # Passer à true si HTTPS activé
cookie_samesite = lax
x_frame_options = SAMEORIGIN
content_security_policy = false

#################################### Authentification ##########################
[auth]
disable_login_form = false
# Durée de vie du token de session (secondes)
login_maximum_inactive_lifetime_duration = 7d
login_maximum_lifetime_duration = 30d

[auth.anonymous]
enabled = false

[auth.generic_oauth]
enabled = false

#################################### Logs ######################################
[log]
mode = file
level = info

[log.file]
log_rotate = true
max_lines = 1000000
max_size_shift = 28        # 256 Mo max par fichier
daily_rotate = true
max_days = 7
file_name = {{ grafana_log_dir }}/grafana.log

#################################### Snapshots / analytics ####################
[snapshots]
external_enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

#################################### Alerting ##################################
[alerting]
enabled = false
execute_alerts = true

#################################### Unified Alerting ##########################
[unified_alerting]
enabled = true