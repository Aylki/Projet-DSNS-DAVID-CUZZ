# /etc/nginx/nginx.conf - généré par Ansible
# DMZ-RPROXY

user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 1024;
}

http {
    # --- Base ---
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;   # Ne pas divulguer la version nginx

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # --- Logs ---
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # --- TLS sécurisé ---
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_dhparam /etc/nginx/ssl/dhparam.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Certificat wildcard partagé (ou certificat SAN couvrant les 3 domaines)
    ssl_certificate     /etc/nginx/ssl/rproxy.crt;
    ssl_certificate_key /etc/nginx/ssl/rproxy.key;

    # --- Headers de sécurité globaux ---
    add_header X-Frame-Options        SAMEORIGIN   always;
    add_header X-Content-Type-Options nosniff      always;
    add_header X-XSS-Protection       "1; mode=block" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- Timeouts proxy ---
    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
    proxy_buffering       on;

    # --- Headers X-Forwarded ---
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Trust CA interne pour les connexions vers les backends
    proxy_ssl_trusted_certificate {{ pki_ca_cert_path }};
    proxy_ssl_verify on;

    include /etc/nginx/sites-enabled/*.conf;
}
