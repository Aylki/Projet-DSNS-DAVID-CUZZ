# webmail.itway.fr -> DMZ-MAIL (Mailcow / Roundcube)
# Généré par Ansible

upstream dmz_mail_webmail {
    server {{ dmz_mail_ip }}:443;
    keepalive 8;
}

server {
    listen 80;
    server_name webmail.{{ domain_external }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name webmail.{{ domain_external }};

    access_log /var/log/nginx/webmail.access.log main;
    error_log  /var/log/nginx/webmail.error.log warn;

    location / {
        proxy_pass https://dmz_mail_webmail;
        proxy_ssl_name mail.{{ domain_external }};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Pièces jointes
        client_max_body_size 25m;

        # WebSocket pour Mailcow
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
