# sso.itway.fr -> SRV-SSO (Keycloak)
# IMPORTANT : seuls les endpoints publics OIDC sont exposés
# L'interface d'admin Keycloak (/auth/admin) reste bloquée depuis Internet
# Généré par Ansible

upstream srv_sso {
    server {{ srv_sso_ip }}:8443;
    keepalive 8;
}

server {
    listen 80;
    server_name sso.{{ domain_external }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sso.{{ domain_external }};

    access_log /var/log/nginx/sso.access.log main;
    error_log  /var/log/nginx/sso.error.log warn;

    # --- Endpoints publics OIDC/OAuth2 ---
    location ~ ^/realms/ {
        proxy_pass https://srv_sso;
        proxy_ssl_name sso.{{ domain_internal }};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Nécessaire pour les redirections Keycloak
        proxy_buffer_size          128k;
        proxy_buffers              4 256k;
        proxy_busy_buffers_size    256k;
    }

    # Ressources statiques Keycloak
    location /resources/ {
        proxy_pass https://srv_sso;
        proxy_ssl_name sso.{{ domain_internal }};
        proxy_set_header Host $host;
    }

    # --- Bloquer l'admin depuis Internet ---
    location ~ ^/(auth/admin|admin|master) {
        allow 10.0.3.0/28;
        allow 10.0.4.0/27;
        allow 192.168.15.0/24;
        allow 10.0.5.0/28;    # Réseaux internes seulement
        deny  all;
        proxy_pass https://srv_sso;
        proxy_ssl_name sso.{{ domain_internal }};
        proxy_set_header Host $host;
    }

    # Bloquer tout le reste par défaut
    location / {
        return 403;
    }
}
