# itway.fr -> DMZ-WEB (WordPress)
# Généré par Ansible

upstream dmz_web {
    server {{ dmz_web_ip }}:443;
    keepalive 16;
}

# Redirection HTTP -> HTTPS
server {
    listen 80;
    server_name {{ domain_external }} www.{{ domain_external }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ domain_external }} www.{{ domain_external }};

    # Logs spécifiques
    access_log /var/log/nginx/itway.fr.access.log main;
    error_log  /var/log/nginx/itway.fr.error.log warn;

    location / {
        proxy_pass https://dmz_web;
        proxy_ssl_name dmz-web.int.{{ domain_external }};

        # WordPress a besoin du host d'origine pour ses redirections
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Uploads WP
        client_max_body_size 64m;
    }

    # Bloquer l'accès direct à wp-admin depuis Internet
    location /wp-admin {
        # Autoriser uniquement les réseaux internes
        allow 10.0.3.0/28;
        allow 10.0.4.0/27;
        allow 192.168.15.0/24;
        deny all;
        proxy_pass https://dmz_web;
        proxy_set_header Host $host;
    }
}
