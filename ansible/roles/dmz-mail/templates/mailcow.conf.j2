# /opt/mailcow-dockerized/mailcow.conf
# Généré par Ansible - Ne pas modifier manuellement

MAILCOW_HOSTNAME=mail.{{ domain_external }}
MAILCOW_PASS_SCHEME=BLF-CRYPT

# Timezone
TZ=Europe/Paris

# HTTP/HTTPS ports du webmail (Nginx Mailcow interne)
# On expose 80/443 directement car on est derrière le DMZ-RPROXY
HTTP_PORT=80
HTTP_BIND=0.0.0.0
HTTPS_PORT=443
HTTPS_BIND=0.0.0.0

# Ports mail
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# On désactive le renouvellement ACME (on gère notre propre CA interne)
SKIP_LETS_ENCRYPT=y
SKIP_CLAMD=n
SKIP_SOLR=n

# Limite mémoire ClamAV
CLAMD_DB_VOLUME_MAX=200M

# LDAP / AD - utilisé par dovecot et SOGo
LDAP_ENABLED=y
LDAP_HOST={{ srv_ads01_ip }}   # AD-SRV : 10.0.4.2
LDAP_PORT=636
LDAP_USE_TLS=yes
LDAP_TLS_CACERT={{ pki_ca_cert_path }}
LDAP_BASE_DN=dc=itway,dc=local
LDAP_BIND_DN=cn=svc-mail,ou=Services,dc=itway,dc=local
LDAP_BIND_PASSWORD={{ mail_ldap_bind_password }}
LDAP_FILTER=(&(objectClass=user)(memberOf=cn=GRP-SECU-DIR,ou=Groupes,dc=itway,dc=local))

# Acl admin
MAILCOW_ADMIN_USER=admin
MAILCOW_ADMIN_PASSWORD={{ mailcow_admin_password }}

# Docker network
IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64

DBNAME=mailcow
DBUSER=mailcow
DBPASS={{ mailcow_db_password }}
DBROOT={{ mailcow_db_root_password }}

REDIS_SLAVEOF_IP=
REDIS_SLAVEOF_PORT=

LOG_LINES=9999
